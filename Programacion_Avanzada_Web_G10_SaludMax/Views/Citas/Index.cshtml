@model IEnumerable<Programacion_Avanzada_Web_G10_SaludMax.Models.Cita>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                Fecha de la cita
            </th>
            <th>
                Horario
            </th>
            <th>
                Estado
            </th>
            <th>
                Usuario
            </th>
            <th>
                Servicio médico
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Fecha.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @(item.Horario != null
                        ? item.Horario.Hora.ToString(@"hh\:mm")
                        : "Sin horario")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Estado)
                </td>
                <td>
                    @(item.Usuario?.Nombre ?? "Sin usuario")
                </td>
                <td>
                    @(item.ServicioMedico?.Nombre ?? "Sin servicio")
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>