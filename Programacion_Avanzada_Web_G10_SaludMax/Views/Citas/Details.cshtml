@model Cita
@{ ViewData["Title"] = "Detalle de cita"; }
<div class="container page-shell"><div class="auth-wrap mt-0"><div class="panel"><span class="badge-status">@Model.Estado</span><h1 class="mt-3">@Model.ServicioMedico?.Nombre</h1><dl class="row mt-4"><dt class="col-5">Fecha</dt><dd class="col-7">@Model.Fecha.ToString("dd/MM/yyyy")</dd><dt class="col-5">Horario</dt><dd class="col-7">@Model.Horario?.Hora.ToString(@"hh\:mm")</dd>@if (User.IsInRole("Administrador")) { <dt class="col-5">Paciente</dt><dd class="col-7">@Model.Usuario?.Nombre</dd> }</dl><a class="btn btn-outline-dark" asp-action="Index">Volver</a></div></div></div>
