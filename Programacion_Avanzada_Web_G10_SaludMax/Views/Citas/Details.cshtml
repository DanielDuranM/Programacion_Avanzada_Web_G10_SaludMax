@model Programacion_Avanzada_Web_G10_SaludMax.Models.Cita

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Cita</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Fecha de la cita
        </dt>
        <dd class="col-sm-10">
            @Model.Fecha.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-2">
            Horario
        </dt>
        <dd class="col-sm-10">
            @(Model.Horario != null
                ? Model.Horario.Hora.ToString(@"hh\:mm")
                : "Sin horario")
        </dd>

        <dt class="col-sm-2">
            Estado
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Estado)
        </dd>

        <dt class="col-sm-2">
            Usuario
        </dt>
        <dd class="col-sm-10">
            @(Model.Usuario?.Nombre ?? "Sin usuario")
        </dd>

        <dt class="col-sm-2">
            Servicio médico
        </dt>
        <dd class="col-sm-10">
            @(Model.ServicioMedico?.Nombre ?? "Sin servicio")
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>