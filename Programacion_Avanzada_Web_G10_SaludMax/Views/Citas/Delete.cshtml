@model Programacion_Avanzada_Web_G10_SaludMax.Models.Cita

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Cita</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Fecha de la cita
        </dt>
        <dd class="col-sm-10">
            @Model.Fecha.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-2">
            Horario
        </dt>
        <dd class="col-sm-10">
            @(Model.Horario != null
                ? Model.Horario.Hora.ToString(@"hh\:mm")
                : "Sin horario")
        </dd>

        <dt class="col-sm-2">
            Estado
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Estado)
        </dd>

        <dt class="col-sm-2">
            Usuario
        </dt>
        <dd class="col-sm-10">
            @(Model.Usuario?.Nombre ?? "Sin usuario")
        </dd>

        <dt class="col-sm-2">
            Servicio médico
        </dt>
        <dd class="col-sm-10">
            @(Model.ServicioMedico?.Nombre ?? "Sin servicio")
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />
        |
        <a asp-action="Index">Back to List</a>
    </form>
</div>