@model ServicioMedico
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="field"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
<div class="field"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" rows="5" class="form-control"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div>
<button class="btn btn-primary">Guardar</button><a class="btn btn-outline-dark" asp-action="Index">Cancelar</a>
