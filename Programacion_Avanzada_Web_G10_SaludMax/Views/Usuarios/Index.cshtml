@model IEnumerable<Usuario>
@{ ViewData["Title"] = "Usuarios"; }
<section class="page-banner"><div class="container page-shell"><span class="eyebrow">Administración</span><h1 class="page-title">Usuarios</h1></div></section>
<section class="container section-pad"><div class="text-end mb-3"><a class="btn btn-dark" asp-action="Create">Agregar usuario</a></div><div class="table-wrap"><table class="table align-middle"><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Nombre</td><td>@item.Correo</td><td>@item.Rol?.Nombre</td><td><a asp-action="Edit" asp-route-id="@item.Id">Editar</a> · <a asp-action="Details" asp-route-id="@item.Id">Detalle</a> · <a class="text-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a></td></tr> }</tbody></table></div></section>
