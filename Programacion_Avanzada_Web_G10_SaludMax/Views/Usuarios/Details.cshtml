@model Usuario
@{ ViewData["Title"] = "Detalle del usuario"; }
<div class="container page-shell"><div class="auth-wrap mt-0"><div class="panel"><span class="eyebrow">Usuario</span><h1>@Model.Nombre</h1><p><b>Correo:</b> @Model.Correo</p><p><b>Rol:</b> @Model.Rol?.Nombre</p><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a><a class="btn btn-outline-dark" asp-action="Index">Volver</a></div></div></div>
