@{
    ViewData["Title"] = "Acerca de";
}

<section class="page-banner">
    <div class="container page-shell">
        <span class="eyebrow">Conócenos</span>
        <h1 class="page-title">Salud para todos, sin complicaciones.</h1>
    </div>
</section>

<section class="container section-pad">
    <div class="contact-grid">
        <div>
            <span class="eyebrow">Nuestra misión</span>
            <h2 class="mt-2">Una atención más accesible y organizada.</h2>
        </div>

        <div class="panel">
            <p>SaludMAX es una empresa de servicios de salud que impulsa una atención cercana mediante herramientas digitales.</p>
            <p>Nuestra plataforma centraliza servicios médicos, usuarios y citas para reducir procesos manuales y ofrecer una experiencia clara, eficiente y segura.</p>

            <div class="info-list mt-4">
                <div class="info-item"><b>Misión</b><br />Facilitar el acceso oportuno a servicios de salud de calidad.</div>
                <div class="info-item"><b>Horario</b><br />Lunes a viernes, de 8:00 a. m. a 5:00 p. m.</div>
                <div class="info-item"><b>Ubicación</b><br />San José, Costa Rica.</div>
            </div>
        </div>
    </div>
</section>