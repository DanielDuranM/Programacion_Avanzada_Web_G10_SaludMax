@model ServicioMedico

@{
    ViewData["Title"] = Model.Nombre;
}

<section class="page-banner">
    <div class="container page-shell">
        <span class="eyebrow">Servicio médico</span>
        <h1 class="page-title">@Model.Nombre</h1>
    </div>
</section>

<section class="container section-pad">
    <div class="panel">
        <p class="lead">@Model.Descripcion</p>

        <div class="d-flex flex-wrap gap-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="btn btn-primary" asp-controller="Citas" asp-action="Create" asp-route-servicioId="@Model.Id">Solicitar cita</a>
            }
            else
            {
                <a class="btn btn-primary" asp-controller="Cuenta" asp-action="IniciarSesion">Ingresar para solicitar</a>
            }

            <a class="btn btn-outline-dark" asp-action="Index">Volver</a>
        </div>
    </div>
</section>