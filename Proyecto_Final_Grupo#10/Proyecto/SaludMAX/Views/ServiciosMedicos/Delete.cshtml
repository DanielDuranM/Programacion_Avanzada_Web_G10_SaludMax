@model ServicioMedico
@{ ViewData["Title"] = "Eliminar servicio"; }
<div class="container page-shell"><div class="auth-wrap mt-0"><div class="panel"><h1>Eliminar servicio</h1><p>¿Deseas eliminar <b>@Model.Nombre</b>?</p><form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" /><button class="btn btn-danger">Eliminar</button><a class="btn btn-outline-dark" asp-action="Index">Cancelar</a></form></div></div></div>
