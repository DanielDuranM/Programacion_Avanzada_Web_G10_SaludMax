@model Cita

@{
    ViewData["Title"] = "Solicitar cita";
}

<section class="page-banner">
    <div class="container page-shell">
        <span class="eyebrow">Agenda tu atención</span>
        <h1 class="page-title">Solicitar cita</h1>
        <p>Selecciona un servicio, una fecha y un horario disponible.</p>
    </div>
</section>

<div class="container section-pad">
    <div class="auth-wrap mt-0">
        <form asp-controller="Citas" asp-action="Create" method="post" class="panel">
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}